#!/bin/sh
# ABOUTME: Build and run the vmobs appliance container from a checkout.
# ABOUTME: Usage: scripts/vmobs-container up|build|start|stop|status|logs|init-auth
#
# The security profiles this passes to docker are the narrow ones in deploy/,
# measured in docs/design/container-boundary.md. Nothing here runs as root on the
# host; loading the AppArmor profile is the one root step and it is a documented
# prerequisite, not something this script does behind your back.
set -eu

cd "$(dirname "$0")/.."
REPO="$(pwd)"

NAME="${VMOBS_CONTAINER_NAME:-vmobs}"
IMAGE="${VMOBS_IMAGE:-vmobs}"
STATE_VOLUME="${VMOBS_STATE_VOLUME:-vmobs-state}"
RUNTIME_VOLUME="${VMOBS_RUNTIME_VOLUME:-vmobs-runtime}"
APPARMOR_PROFILE="${VMOBS_APPARMOR_PROFILE:-vmobs-jailer}"
SECCOMP_PROFILE="$REPO/deploy/seccomp/vmobs-jailer.json"
LISTEN="${VMOBS_LISTEN:-127.0.0.1:8787}"

die() { printf 'vmobs-container: %s\n' "$*" >&2; exit 1; }
note() { printf '%s\n' "$*"; }

need_docker() {
    command -v docker >/dev/null 2>&1 || die "docker is not on PATH; see deploy/README.md"
    docker info >/dev/null 2>&1 || die "cannot talk to the docker daemon; is it running, and is this user in the docker group?"
}

# revision_for prints the commit this image is being built from, with "-dirty"
# appended when the tree it was built from had uncommitted changes.
#
# The environment is asked before git, and that order is the point: this script
# runs on the Linux host against a tree rsynced without .git (scripts/linux),
# where git can answer nothing. That wrapper carries the answer across in
# VMOBS_SOURCE_REVISION and VMOBS_SOURCE_DIRTY, the same pair the integration
# gate binds its evidence to. With neither source the revision is "unknown" --
# said out loud in the image, never guessed.
revision_for() {
    if [ -n "${VMOBS_SOURCE_REVISION:-}" ]; then
        if [ "${VMOBS_SOURCE_DIRTY:-0}" = "1" ]; then
            echo "$VMOBS_SOURCE_REVISION-dirty"
        else
            echo "$VMOBS_SOURCE_REVISION"
        fi
        return
    fi
    if git -C "$REPO" rev-parse HEAD >/dev/null 2>&1; then
        rev="$(git -C "$REPO" rev-parse HEAD)"
        if [ -n "$(git -C "$REPO" status --porcelain)" ]; then
            echo "$rev-dirty"
        else
            echo "$rev"
        fi
        return
    fi
    echo "unknown"
}

# tag_for prints the image tag: the short revision, "-dirty" when the tree was
# modified, and "local" when nothing can say what the tree is.
tag_for() {
    rev="$(revision_for)"
    case "$rev" in
        unknown) echo "$IMAGE:local" ;;
        *-dirty) echo "$IMAGE:$(printf '%s' "${rev%-dirty}" | cut -c1-7)-dirty" ;;
        *)       echo "$IMAGE:$(printf '%s' "$rev" | cut -c1-7)" ;;
    esac
}

# require_guest_images fails before the docker build rather than 500 layers in.
# The guest kernel and root image are not in the checkout: they are downloaded
# against the digests in runtime.lock.json, or built from source when nothing has
# been published. `up` does that step; `build` names it rather than doing it
# behind your back.
require_guest_images() {
    for rel in images/dist/vmlinux images/dist/rootfs.ext4; do
        [ -f "$REPO/$rel" ] || die "missing $rel — get the guest images first:
    scripts/fetch-guest-images
  That downloads them and checks each against its pin in runtime.lock.json. If
  nothing has been published it says so and names images/build-all.sh, which
  compiles the guest kernel from source and takes a while."
    done
}

cmd_build() {
    need_docker
    require_guest_images
    tag="$(tag_for)"
    note "building $tag"
    docker build \
        --file "$REPO/deploy/Dockerfile" \
        --build-arg "SOURCE_REVISION=$(revision_for)" \
        --tag "$tag" \
        --tag "$IMAGE:latest" \
        "$REPO"
    note "built $tag"
}

# preflight_host checks what docker cannot report clearly on its own. Each
# failure names the one thing to change; none of them is fixed silently.
preflight_host() {
    [ -c /dev/kvm ] || die "/dev/kvm is missing — this host cannot run VMs.
  Check that KVM is enabled in firmware and the kvm module is loaded (lsmod | grep kvm)."
    [ -c /dev/net/tun ] || die "/dev/net/tun is missing — load the tun module (modprobe tun)."
    [ -f "$SECCOMP_PROFILE" ] || die "missing $SECCOMP_PROFILE"
    # "unconfined" is docker's own reserved value for "no profile", so it names
    # no file and the file check cannot pass for it. It is how the container comes
    # up on a host where the profile has not been loaded yet -- loading it is root
    # work, and root work is a step an operator takes deliberately. It drops the
    # mount confinement, so cmd_start says so out loud rather than letting a
    # weaker boundary pass quietly for the shipped one.
    case "$APPARMOR_PROFILE" in
        unconfined) ;;
        *) preflight_apparmor ;;
    esac
}

# preflight_apparmor checks the two things docker's own error cannot separate:
# a host with no AppArmor at all, and a host whose loaded profile is older than
# the repo's.
#
# What the kernel actually holds is not readable here --
# /sys/kernel/security/apparmor/profiles is 0444 root-only -- so the comparison
# is against /etc/apparmor.d/<name>, the copy the host loads at boot. That is
# the honest check, and it catches the failure that costs the most: docker
# accepts any loaded profile by name, so a stale one starts cleanly and then
# denies a mount in the middle of a launch, minutes later and nowhere near the
# cause.
preflight_apparmor() {
    src="$REPO/deploy/apparmor/$APPARMOR_PROFILE"
    dest="/etc/apparmor.d/$APPARMOR_PROFILE"
    [ -f "$src" ] || die "missing deploy/apparmor/$APPARMOR_PROFILE"

    enabled=""
    [ -r /sys/module/apparmor/parameters/enabled ] && enabled="$(cat /sys/module/apparmor/parameters/enabled)"
    if [ "$enabled" != "Y" ]; then
        die "this host has no AppArmor enabled, so the profile cannot load.
  Enable AppArmor, or accept the weaker boundary and start with:
    VMOBS_APPARMOR_PROFILE=unconfined scripts/vmobs-container start
  (that drops the mount confinement; seccomp and the capabilities still apply.)"
    fi

    if [ ! -f "$dest" ]; then
        die "$APPARMOR_PROFILE is not installed at $dest, so this host does not load it at boot.
  Install and load it once, as root:
    sudo sh deploy/install-apparmor.sh"
    fi
    if ! cmp -s "$src" "$dest"; then
        die "the profile installed at $dest differs from deploy/apparmor/$APPARMOR_PROFILE.
  docker would accept the installed one by name and the difference would surface
  later, as a denied mount in the middle of a launch. Reload it, as root:
    sudo sh deploy/install-apparmor.sh"
    fi
}

cmd_start() {
    need_docker
    preflight_host
    tag="${1:-$(tag_for)}"
    docker image inspect "$tag" >/dev/null 2>&1 || die "image $tag not built — run: scripts/vmobs-container build"
    if docker container inspect "$NAME" >/dev/null 2>&1; then
        die "container $NAME already exists — run: scripts/vmobs-container stop"
    fi

    note "starting $NAME from $tag"
    if [ "$APPARMOR_PROFILE" = unconfined ]; then
        note "WARNING: apparmor=unconfined — the jailer's mounts are not confined"
    fi
    # --init: firecracker is daemonized by the jailer, so every VMM reparents to
    #   PID 1. Without a reaper they linger as zombies, and a zombie answers
    #   kill(pid, 0) — the runtime's liveness check would call a dead VM alive.
    # --network host: the API binds loopback (server.mode: loopback_only), so the
    #   container's loopback has to be the host's for anyone to reach it. See the
    #   note at the top of deploy/config.yaml.
    # The two profiles and the two capabilities are docs/design/container-boundary.md
    #   §5 exactly: SYS_ADMIN for setns and the jailer's mounts, NET_ADMIN plus
    #   /dev/net/tun for tap and veth, the AppArmor profile for mount, the seccomp
    #   profile for pivot_root.
    # stderr is captured, stdout (the container id) discarded. A run that fails
    # inside the OCI runtime still leaves the container in Created state, so it
    # is removed here -- otherwise the next start reports "already exists" and
    # buries the real reason.
    if ! err="$(docker run --detach --name "$NAME" \
        --init \
        --network host \
        --cap-add SYS_ADMIN \
        --cap-add NET_ADMIN \
        --device /dev/kvm \
        --device /dev/net/tun \
        --security-opt "apparmor=$APPARMOR_PROFILE" \
        --security-opt "seccomp=$SECCOMP_PROFILE" \
        --tmpfs /run:mode=0755 \
        --volume "$STATE_VOLUME:/var/lib/vmobs" \
        --volume "$RUNTIME_VOLUME:/srv/vmobs" \
        --restart no \
        "$tag" 2>&1 >/dev/null)"
    then
        docker rm -f "$NAME" >/dev/null 2>&1 || true
        case "$err" in
            *apparmor*|*AppArmor*)
                die "docker refused the AppArmor profile:
  $err
  Install and load it once, as root:
    sudo sh deploy/install-apparmor.sh" ;;
            *)
                die "docker run failed:
  $err" ;;
        esac
    fi
    note "started; the API is at http://$LISTEN"
    note "follow it with: scripts/vmobs-container logs"
}

# cmd_up is the whole install: artifacts, prerequisites, image, container. It
# does the steps in that order for one reason -- the AppArmor profile is the only
# root step, and an operator who has to run it should learn that in the first few
# seconds rather than after a ten-minute docker build.
#
# It installs nothing on the host and asks for no privilege. The root line it
# stops on is a line for a human to read and run.
cmd_up() {
    need_docker
    if docker container inspect "$NAME" >/dev/null 2>&1; then
        die "container $NAME already exists.
  See what it is doing:  scripts/vmobs-container status
  Or replace it:         scripts/vmobs-container stop && scripts/vmobs-container up"
    fi

    note "==> guest images"
    sh "$REPO/scripts/fetch-guest-images"

    note "==> host prerequisites"
    preflight_host
    note "ok"

    note "==> image"
    cmd_build

    note "==> container"
    cmd_start
}

cmd_stop() {
    need_docker
    docker container inspect "$NAME" >/dev/null 2>&1 || { note "$NAME is not present"; return 0; }
    note "stopping $NAME"
    docker stop "$NAME" >/dev/null
    docker rm "$NAME" >/dev/null
    note "stopped and removed $NAME"
    note "volumes $STATE_VOLUME and $RUNTIME_VOLUME are kept; remove them with:"
    note "  docker volume rm $STATE_VOLUME $RUNTIME_VOLUME"
}

cmd_status() {
    need_docker
    if ! docker container inspect "$NAME" >/dev/null 2>&1; then
        note "container:  absent"
        return 0
    fi
    note "container:  $(docker container inspect --format '{{.State.Status}} (started {{.State.StartedAt}})' "$NAME")"
    note "image:      $(docker container inspect --format '{{.Config.Image}}' "$NAME")"
    note "revision:   $(docker exec "$NAME" cat /opt/vmobs/SOURCE_REVISION 2>/dev/null || echo 'unreadable')"
    if docker exec "$NAME" test -S /run/vmobs/privd.sock 2>/dev/null; then
        note "privd:      socket present"
    else
        note "privd:      socket ABSENT"
    fi
    if command -v curl >/dev/null 2>&1; then
        note "api:        $(curl -fsS --max-time 5 "http://$LISTEN/api/v1/host/status" >/dev/null 2>&1 \
            && echo "GET /api/v1/host/status OK" || echo "GET /api/v1/host/status FAILED")"
    fi
}

cmd_logs() {
    need_docker
    docker logs "$@" "$NAME"
}

cmd_init_auth() {
    need_docker
    docker container inspect "$NAME" >/dev/null 2>&1 && die "stop $NAME first: init-auth writes the credential store the running daemon owns"
    tag="$(tag_for)"
    docker run --rm -i \
        --volume "$STATE_VOLUME:/var/lib/vmobs" \
        "$tag" init-auth "$@"
}

usage() {
    cat >&2 <<'USAGE'
usage: scripts/vmobs-container <command>

  up                 the whole install: guest images, prerequisites, image, container
  build              build the appliance image from this checkout
  start [image:tag]  run it with the profiles from deploy/
  stop               stop and remove the container, keeping the volumes
  status             container state, image revision, privd socket, API reachability
  logs [-f]          docker logs for the container
  init-auth [args]   mint the first operator credential into the state volume

Prerequisites and the security profiles: deploy/README.md
USAGE
    exit 2
}

[ $# -ge 1 ] || usage
command="$1"; shift
case "$command" in
    up)        cmd_up "$@" ;;
    build)     cmd_build "$@" ;;
    start)     cmd_start "$@" ;;
    stop)      cmd_stop "$@" ;;
    status)    cmd_status "$@" ;;
    logs)      cmd_logs "$@" ;;
    init-auth) cmd_init_auth "$@" ;;
    *)         usage ;;
esac
