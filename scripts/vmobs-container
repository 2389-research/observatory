#!/bin/sh
# ABOUTME: Build and run the vmobs appliance container from a checkout.
# ABOUTME: Usage: scripts/vmobs-container build|start|stop|status|logs|init-auth
#
# The security profiles this passes to docker are the narrow ones in deploy/,
# measured in docs/design/container-boundary.md. Nothing here runs as root on the
# host; loading the AppArmor profile is the one root step and it is a documented
# prerequisite, not something this script does behind your back.
set -eu

cd "$(dirname "$0")/.."
REPO="$(pwd)"

NAME="${VMOBS_CONTAINER_NAME:-vmobs}"
IMAGE="${VMOBS_IMAGE:-vmobs}"
STATE_VOLUME="${VMOBS_STATE_VOLUME:-vmobs-state}"
RUNTIME_VOLUME="${VMOBS_RUNTIME_VOLUME:-vmobs-runtime}"
APPARMOR_PROFILE="${VMOBS_APPARMOR_PROFILE:-vmobs-jailer}"
SECCOMP_PROFILE="$REPO/deploy/seccomp/vmobs-jailer.json"
LISTEN="${VMOBS_LISTEN:-127.0.0.1:8787}"

die() { printf 'vmobs-container: %s\n' "$*" >&2; exit 1; }
note() { printf '%s\n' "$*"; }

need_docker() {
    command -v docker >/dev/null 2>&1 || die "docker is not on PATH; see deploy/README.md"
    docker info >/dev/null 2>&1 || die "cannot talk to the docker daemon; is it running, and is this user in the docker group?"
}

# tag_for prints the image tag for the current checkout. A dirty tree tags as
# such: an image built from uncommitted work must not claim a revision.
tag_for() {
    if ! git -C "$REPO" rev-parse HEAD >/dev/null 2>&1; then
        echo "$IMAGE:local"
        return
    fi
    rev="$(git -C "$REPO" rev-parse --short HEAD)"
    if [ -n "$(git -C "$REPO" status --porcelain)" ]; then
        echo "$IMAGE:$rev-dirty"
    else
        echo "$IMAGE:$rev"
    fi
}

revision_for() {
    if git -C "$REPO" rev-parse HEAD >/dev/null 2>&1; then
        rev="$(git -C "$REPO" rev-parse HEAD)"
        if [ -n "$(git -C "$REPO" status --porcelain)" ]; then
            echo "$rev-dirty"
        else
            echo "$rev"
        fi
    else
        echo "unknown"
    fi
}

# require_guest_images fails before the docker build rather than 500 layers in.
# The guest kernel and root image are built by images/build-all.sh, which needs a
# kernel toolchain and half an hour; they are not in the checkout and this script
# will not silently build them for you.
require_guest_images() {
    for rel in images/dist/vmlinux images/dist/rootfs.ext4; do
        [ -f "$REPO/$rel" ] || die "missing $rel — build the guest images first:
    bash images/build-all.sh
  It needs docker and a kernel build toolchain, and it pins the digests it
  produces into runtime.lock.json."
    done
}

cmd_build() {
    need_docker
    require_guest_images
    tag="$(tag_for)"
    note "building $tag"
    docker build \
        --file "$REPO/deploy/Dockerfile" \
        --build-arg "SOURCE_REVISION=$(revision_for)" \
        --tag "$tag" \
        --tag "$IMAGE:latest" \
        "$REPO"
    note "built $tag"
}

# preflight_host checks what docker cannot report clearly on its own. Each
# failure names the one thing to change; none of them is fixed silently.
preflight_host() {
    [ -c /dev/kvm ] || die "/dev/kvm is missing — this host cannot run VMs.
  Check that KVM is enabled in firmware and the kvm module is loaded (lsmod | grep kvm)."
    [ -c /dev/net/tun ] || die "/dev/net/tun is missing — load the tun module (modprobe tun)."
    [ -f "$SECCOMP_PROFILE" ] || die "missing $SECCOMP_PROFILE"
    [ -f "$REPO/deploy/apparmor/$APPARMOR_PROFILE" ] || die "missing deploy/apparmor/$APPARMOR_PROFILE"
}

cmd_start() {
    need_docker
    preflight_host
    tag="${1:-$(tag_for)}"
    docker image inspect "$tag" >/dev/null 2>&1 || die "image $tag not built — run: scripts/vmobs-container build"
    if docker container inspect "$NAME" >/dev/null 2>&1; then
        die "container $NAME already exists — run: scripts/vmobs-container stop"
    fi

    note "starting $NAME from $tag"
    # --init: firecracker is daemonized by the jailer, so every VMM reparents to
    #   PID 1. Without a reaper they linger as zombies, and a zombie answers
    #   kill(pid, 0) — the runtime's liveness check would call a dead VM alive.
    # --network host: the API binds loopback (server.mode: loopback_only), so the
    #   container's loopback has to be the host's for anyone to reach it. See the
    #   note at the top of deploy/config.yaml.
    # The two profiles and the two capabilities are docs/design/container-boundary.md
    #   §5 exactly: SYS_ADMIN for setns and the jailer's mounts, NET_ADMIN plus
    #   /dev/net/tun for tap and veth, the AppArmor profile for mount, the seccomp
    #   profile for pivot_root.
    if ! docker run --detach --name "$NAME" \
        --init \
        --network host \
        --cap-add SYS_ADMIN \
        --cap-add NET_ADMIN \
        --device /dev/kvm \
        --device /dev/net/tun \
        --security-opt "apparmor=$APPARMOR_PROFILE" \
        --security-opt "seccomp=$SECCOMP_PROFILE" \
        --tmpfs /run:mode=0755 \
        --volume "$STATE_VOLUME:/var/lib/vmobs" \
        --volume "$RUNTIME_VOLUME:/srv/vmobs" \
        --restart no \
        "$tag" >/dev/null 2>"$REPO/.vmobs-run-error"
    then
        err="$(cat "$REPO/.vmobs-run-error" 2>/dev/null || true)"
        rm -f "$REPO/.vmobs-run-error"
        case "$err" in
            *apparmor*|*AppArmor*|*"profile"*)
                die "docker refused the AppArmor profile:
  $err
  Load it once, as root:
    sudo apparmor_parser -r -W deploy/apparmor/$APPARMOR_PROFILE" ;;
            *)
                die "docker run failed:
  $err" ;;
        esac
    fi
    rm -f "$REPO/.vmobs-run-error"
    note "started; the API is at http://$LISTEN"
    note "follow it with: scripts/vmobs-container logs"
}

cmd_stop() {
    need_docker
    docker container inspect "$NAME" >/dev/null 2>&1 || { note "$NAME is not present"; return 0; }
    note "stopping $NAME"
    docker stop "$NAME" >/dev/null
    docker rm "$NAME" >/dev/null
    note "stopped and removed $NAME"
    note "volumes $STATE_VOLUME and $RUNTIME_VOLUME are kept; remove them with:"
    note "  docker volume rm $STATE_VOLUME $RUNTIME_VOLUME"
}

cmd_status() {
    need_docker
    if ! docker container inspect "$NAME" >/dev/null 2>&1; then
        note "container:  absent"
        return 0
    fi
    note "container:  $(docker container inspect --format '{{.State.Status}} (started {{.State.StartedAt}})' "$NAME")"
    note "image:      $(docker container inspect --format '{{.Config.Image}}' "$NAME")"
    note "revision:   $(docker exec "$NAME" cat /opt/vmobs/SOURCE_REVISION 2>/dev/null || echo 'unreadable')"
    if docker exec "$NAME" test -S /run/vmobs/privd.sock 2>/dev/null; then
        note "privd:      socket present"
    else
        note "privd:      socket ABSENT"
    fi
    if command -v curl >/dev/null 2>&1; then
        note "api:        $(curl -fsS --max-time 5 "http://$LISTEN/api/v1/host/status" >/dev/null 2>&1 \
            && echo "GET /api/v1/host/status OK" || echo "GET /api/v1/host/status FAILED")"
    fi
}

cmd_logs() {
    need_docker
    docker logs "$@" "$NAME"
}

cmd_init_auth() {
    need_docker
    docker container inspect "$NAME" >/dev/null 2>&1 && die "stop $NAME first: init-auth writes the credential store the running daemon owns"
    tag="$(tag_for)"
    docker run --rm -i \
        --volume "$STATE_VOLUME:/var/lib/vmobs" \
        "$tag" init-auth "$@"
}

usage() {
    cat >&2 <<'USAGE'
usage: scripts/vmobs-container <command>

  build              build the appliance image from this checkout
  start [image:tag]  run it with the profiles from deploy/
  stop               stop and remove the container, keeping the volumes
  status             container state, image revision, privd socket, API reachability
  logs [-f]          docker logs for the container
  init-auth [args]   mint the first operator credential into the state volume

Prerequisites and the security profiles: deploy/README.md
USAGE
    exit 2
}

[ $# -ge 1 ] || usage
command="$1"; shift
case "$command" in
    build)     cmd_build "$@" ;;
    start)     cmd_start "$@" ;;
    stop)      cmd_stop "$@" ;;
    status)    cmd_status "$@" ;;
    logs)      cmd_logs "$@" ;;
    init-auth) cmd_init_auth "$@" ;;
    *)         usage ;;
esac
