#!/bin/sh
# ABOUTME: Canonical repository gate: format, vet, lint, tests, docs package check.
# ABOUTME: Run from anywhere as scripts/check; exits nonzero on any failed gate.
set -u
cd "$(dirname "$0")/.."

# Heal a stale inherited GOROOT pointing at a removed toolchain.
if [ -n "${GOROOT:-}" ] && [ ! -d "${GOROOT:-}" ]; then
  unset GOROOT
fi

fail=0
note() { printf '%s\n' "$*"; }

# The Go gates print their own failures. The web gates are noisy enough on
# success that they are silenced, which leaves a failing one naming nothing --
# a flaky vitest run and a real regression print the identical line, and the
# only way to tell them apart is to run the step again by hand. Send that
# output to a file per step and name the file in the failure instead.
logdir="${TMPDIR:-/tmp}"
logdir="${logdir%/}/vmobs-check"   # TMPDIR often ends in a slash
mkdir -p "$logdir"

unformatted=$(gofmt -l cmd internal tests 2>/dev/null)
if [ -n "$unformatted" ]; then
  note "FAIL gofmt — run: gofmt -w $unformatted"
  fail=1
else
  note "PASS gofmt"
fi

if go vet ./...; then note "PASS go vet"; else note "FAIL go vet"; fail=1; fi

if command -v golangci-lint >/dev/null 2>&1; then
  if golangci-lint run ./...; then note "PASS golangci-lint"; else note "FAIL golangci-lint"; fail=1; fi
  # Linux is the only OS this product runs on, and the run above never sees it
  # from a darwin workstation: internal/jailer's and internal/privd's linux
  # files and all of tests/integration are build-tagged out. Cross-lint them.
  # .golangci.yml takes the golangci-lint v2 default linter set, which includes
  # govet, so this covers vet on linux as well.
  if GOOS=linux GOARCH=amd64 golangci-lint run ./...; then
    note "PASS golangci-lint (GOOS=linux)"
  else
    note "FAIL golangci-lint (GOOS=linux)"
    fail=1
  fi
else
  note "FAIL golangci-lint missing — install it (brew install golangci-lint)"
  fail=1
fi

if go test ./...; then note "PASS go test"; else note "FAIL go test"; fail=1; fi

# Ensure the test-only fake runtime never reaches a served binary (SPEC §18).
if env -u GOROOT mise exec -- go list -deps ./cmd/... 2>/dev/null | grep -qF "internal/runtime/runtimetest"; then
  note "FAIL fake runtime reachable from cmd/ — runtimetest must only appear in _test.go imports"
  fail=1
else
  note "PASS fake runtime not reachable from cmd/"
fi

# Web gate. dist/ is committed and embedded, so a stale dist means the daemon
# serves a page that no longer matches web/src. Rebuilding and asking git
# whether anything moved is the only honest way to know.
if command -v npm >/dev/null 2>&1; then
  if (cd web && npm ci && npm run typecheck) >"$logdir/web-typecheck.log" 2>&1; then
    note "PASS web typecheck"
  else
    note "FAIL web typecheck — $logdir/web-typecheck.log; rerun: cd web && npm ci && npm run typecheck"
    fail=1
  fi
  if (cd web && npm test) >"$logdir/web-test.log" 2>&1; then
    note "PASS web tests"
  else
    note "FAIL web tests — $logdir/web-test.log; rerun: cd web && npm test"
    fail=1
  fi
  if (cd web && npm run build) >"$logdir/web-build.log" 2>&1; then
    if git diff --quiet -- web/dist; then
      note "PASS web dist current"
    else
      note "FAIL web dist stale — rebuilt output differs; run scripts/build-web and commit web/dist"
      fail=1
    fi
  else
    note "FAIL web build — $logdir/web-build.log; rerun: scripts/build-web"
    fail=1
  fi
else
  note "FAIL npm missing — install node (brew install node); the gate rebuilds web/dist to prove it is current"
  fail=1
fi

if command -v uv >/dev/null 2>&1; then
  if uv run docs/validation/check.py >/dev/null 2>&1; then
    note "PASS docs package check"
  else
    note "FAIL docs package check — run: uv run docs/validation/check.py"
    fail=1
  fi
else
  note "FAIL uv missing — install uv to run the docs package check"
  fail=1
fi

if [ "$fail" -ne 0 ]; then
  note "check: FAILED"
  exit 1
fi
note "check: all gates passed"
