# ABOUTME: systemd unit for vmobs-privd, the M1 root privilege daemon on aibox03.
# ABOUTME: setup.sh substitutes __ALLOWED_UID__ and __ALLOWED_GID__ before installing.
[Unit]
Description=vmobs privilege daemon (privd)
Documentation=file://%h/vmobs-build/docs/runbooks/aibox03.md
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/vmobs-privd \
  --socket /run/vmobs/privd.sock \
  --ledger-dir /run/vmobs/privd \
  --allowed-uid __ALLOWED_UID__ \
  --allowed-gid __ALLOWED_GID__ \
  --stage-root /srv/vmobs/stage \
  --jail-base /srv/vmobs/jail \
  --firecracker /usr/local/bin/firecracker \
  --jailer /usr/local/bin/jailer
Restart=on-failure
RuntimeDirectory=vmobs vmobs/privd
ProtectHome=read-only
NoNewPrivileges=no

[Install]
WantedBy=multi-user.target
