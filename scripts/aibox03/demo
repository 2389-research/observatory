#!/bin/bash
# ABOUTME: Runs a real vmobsd on the KVM host with a few live microVMs, so the fleet page
# ABOUTME: at /ui/ can be looked at by a human. Usage on aibox03: scripts/aibox03/demo start|stop|status
#
# Why this exists: the daemon refuses to start without a verified Firecracker and
# jailer, so the UI can only be seen on a real host. This puts one there and takes
# it back down again, including the VMs it created — a demo that leaks disk would
# push the host under the gate's floor (see gotchas.md).
#
# Not a test. It proves nothing on its own; it makes the product visible.
set -euo pipefail

REPO="$(cd "$(dirname "$0")/../.." && pwd)"
DEMO="${VMOBS_DEMO_DIR:-$HOME/vmobs-demo}"
PORT="${VMOBS_DEMO_PORT:-8420}"
ADDR="127.0.0.1:$PORT"
API="http://$ADDR/api/v1"
PIDFILE="$DEMO/vmobsd.pid"
LOG="$DEMO/vmobsd.log"
VMLIST="$DEMO/created-vms.txt"

# Small VMs: three of these fit well clear of the gate's ~21 GB floor.
VCPU=1
MEM_MIB=512
ROOT_DISK_MIB=2048
WORKSPACE_DISK_MIB=1024
VM_COUNT="${VMOBS_DEMO_VMS:-3}"

die() { echo "demo: $*" >&2; exit 1; }

running() { [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; }

write_config() {
  mkdir -p "$DEMO/state/templates" "$DEMO/state/spool" "$DEMO/bin"
  # The template's image paths are decorative: the real kernel and rootfs come
  # from runtime.lock.json, resolved against the repo root.
  cat > "$DEMO/state/templates/standard.json" <<'JSON'
{
  "template_id": "standard",
  "description": "Demo VM template",
  "kernel_image": "/srv/vmobs/images/vmlinux",
  "root_image": "/srv/vmobs/images/rootfs.img",
  "guest_privilege_profiles": ["unprivileged"],
  "sensors": ["fanotify"],
  "protocol_versions": {"guestd": "1"}
}
JSON

  # paths.runtime must be exactly /srv/vmobs: the daemon derives its stage root
  # and jail base from it, and both have to match the installed privd's flags.
  cat > "$DEMO/host.yaml" <<YAML
config_version: 1
server:
  listen: "$ADDR"
  public_origin: "http://$ADDR"
  mode: loopback_only
auth:
  mode: local_operator
  require_authentication: false
  credential_store: "$DEMO/state/auth"
  csrf_protection: true
  session_cookie_http_only: true
  session_cookie_same_site: strict
  session_cookie_secure: false
  session_ttl_minutes: 720
paths:
  state: "$DEMO/state"
  runtime: "/srv/vmobs"
  approved_templates: "$DEMO/state/templates"
  runtime_lock: "$REPO/runtime.lock.json"
  privileged_socket: "/run/vmobs/privd.sock"
runtime:
  mode: firecracker
  lock_file: "$REPO/runtime.lock.json"
  jail_uid_base: 20000
  jail_gid: 36000
  cid_base: 3
admission:
  allow_memory_overcommit: false
  cpu_overcommit_ratio: 4.0
  reserve_host_cpu_cores: 2
  reserve_host_memory_min_mib: 4096
  reserve_host_memory_fraction: 0.20
  reserve_per_vm_host_overhead_mib: 768
  reserve_inspection_slots: 0
  reserve_inspector_memory_mib: 0
  reserve_inspector_cpu_cores: 0
  reserve_inspector_scratch_mib: 0
  max_parallel_provisions: 2
  max_batch_size: 8
  default_batch_reservation: atomic_reservation
  default_batch_on_failure: keep_successful
vm_defaults:
  vcpu_count: $VCPU
  memory_mib: $MEM_MIB
  root_disk_mib: $ROOT_DISK_MIB
  workspace_disk_mib: $WORKSPACE_DISK_MIB
  guest_privilege: unprivileged
  network_profile: transport
  network_policy_id: ""
  disk_allocation: ""
  max_terminal_sessions: 0
  stop_grace_seconds: 30
network:
  ipv4_only_guest_boundary: false
  drop_guest_ipv6_on_host: false
  deny_cross_vm: false
  deny_host_and_special_use_destinations: false
  policy_directory: ""
  proxy_per_vm: false
  proxy_ca_per_vm: false
  proxy_upstream_tls_verify: false
  proxy_failure: ""
  raw_pcap_default: false
observation:
  filesystem_reads_default: false
  required_by_default: false
  failure_action_default: ""
  heartbeat_interval_seconds: 0
  heartbeat_timeout_seconds: 0
  max_frame_bytes: 0
  max_guest_pending_bytes: 0
  max_runner_spool_bytes: 0
  host_emergency_reserve_bytes: 0
  spool_ack_barrier: ""
  source_deduplication: ""
terminal:
  max_replay_bytes_per_session: 0
  max_wire_chunk_bytes: 0
  max_inflight_browser_bytes: 0
  writer_lease_seconds: 0
  record_input: false
  persist_output_default: false
  automatic_clipboard_write: false
  automatic_download: false
capture:
  http_headers_default: ""
  http_bodies_default: ""
  max_header_bytes: 0
  max_body_preview_bytes: 0
  max_file_preview_bytes: 0
  redact_before_persistence: false
  allow_unredacted_proxy_flow_dump: false
agent_interface:
  situation_max_response_bytes: 65536
  attention_queue_max_items: 500
  attention_collapse_duplicates: true
  attention_triggers:
    lifecycle_failed: true
    run_concluded: true
    telemetry_degraded: true
    spool_threshold: true
    disk_reserve_threshold: true
    policy_denial_anomaly: true
    capacity_exhausted: true
    reconciliation_surprise: true
  run_goal_max_bytes: 2048
  guest_result_max_bytes: 65536
  report_tail_max_bytes: 4096
storage:
  database: "$DEMO/state/vmobs.sqlite"
  sqlite_journal_mode: WAL
  sqlite_synchronous: FULL
  logical_writers: 1
  event_retention_days: 30
  artifact_retention_days: 7
  raw_disk_export_requires_separate_authorization: true
  untrusted_host_kernel_mounts: prohibited
YAML
}

start() {
  running && die "already running (pid $(cat "$PIDFILE")); run 'demo stop' first"
  [ -S /run/vmobs/privd.sock ] || die "privd socket absent; run scripts/aibox03/setup.sh"

  echo "demo: building vmobsd and vmobs-runner"
  mkdir -p "$DEMO/bin"
  # The runner must sit beside the daemon: the daemon resolves it as a sibling
  # of its own executable, never from PATH.
  (cd "$REPO" && env -u GOROOT go build -o "$DEMO/bin/vmobsd" ./cmd/vmobsd)
  (cd "$REPO" && env -u GOROOT go build -o "$DEMO/bin/vmobs-runner" ./cmd/vmobs-runner)

  write_config
  : > "$VMLIST"

  echo "demo: starting daemon on $ADDR"
  "$DEMO/bin/vmobsd" -config "$DEMO/host.yaml" > "$LOG" 2>&1 &
  echo $! > "$PIDFILE"

  for _ in $(seq 1 40); do
    if curl -fsS "$API/meta" > /dev/null 2>&1; then break; fi
    if ! kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
      rm -f "$PIDFILE"
      echo "--- daemon log ---" >&2; tail -30 "$LOG" >&2
      die "daemon exited during startup"
    fi
    sleep 0.5
  done
  curl -fsS "$API/meta" > /dev/null || die "daemon did not answer /meta; see $LOG"

  echo "demo: creating $VM_COUNT VMs"
  for i in $(seq 1 "$VM_COUNT"); do
    body=$(curl -fsS -X POST "$API/vms" -H 'content-type: application/json' -d "{
      \"name\": \"demo-$i\",
      \"template_id\": \"standard\",
      \"vcpu_count\": $VCPU,
      \"memory_mib\": $MEM_MIB,
      \"root_disk_mib\": $ROOT_DISK_MIB,
      \"workspace_disk_mib\": $WORKSPACE_DISK_MIB
    }") || { echo "demo: create demo-$i failed" >&2; continue; }
    id=$(printf '%s' "$body" | sed -n 's/.*"vm_id":"\([^"]*\)".*/\1/p')
    [ -n "$id" ] && echo "$id" >> "$VMLIST" && echo "demo:   demo-$i = $id"
  done

  echo
  echo "demo: up. From your laptop:"
  echo "  ssh -N -L $PORT:127.0.0.1:$PORT harper@100.64.0.100"
  echo "  open http://127.0.0.1:$PORT/ui/"
  echo "demo: log at $LOG"
}

stop() {
  if [ -f "$VMLIST" ] && running; then
    while read -r id; do
      [ -n "$id" ] || continue
      echo "demo: deleting $id"
      # force=true: the API refuses to delete a live VM without it, and every VM
      # this script creates is live. Without force the teardown reports success
      # while leaving firecracker processes and their disk behind.
      # --fail-with-body: a 4xx must be a failure here, and its typed body is
      # the only thing that says why. Plain -sS treats a refusal as success.
      if ! err=$(curl -sS --fail-with-body -X DELETE "$API/vms/$id?force=true" 2>&1); then
        echo "demo:   delete $id failed: $err" >&2
      fi
    done < "$VMLIST"
    # Deletion is asynchronous; give release a chance to land before the daemon
    # goes. Count only VMs still holding resources: a deleted VM keeps its row
    # for ever (SPEC §5.4), so an unfiltered list never drains and this loop
    # would spend its whole budget every time.
    live="state=provisioning&state=starting&state=running&state=paused&state=stopping&state=deleting"
    for _ in $(seq 1 60); do
      # -o then wc: the response is one line, so grep -c would answer 1 for any
      # number of VMs and the message below would understate what is left.
      left=$(curl -fsS "$API/vms?$live" 2>/dev/null | grep -o '"vm_id"' | wc -l | tr -d ' ')
      [ "$left" = "0" ] && break
      sleep 1
    done
    [ "${left:-0}" = "0" ] || echo "demo:   $left VM(s) still live after 60s — check $LOG" >&2
    rm -f "$VMLIST"
  fi
  if running; then
    pid=$(cat "$PIDFILE")
    echo "demo: stopping daemon (pid $pid)"
    kill "$pid" 2>/dev/null || true
    for _ in $(seq 1 30); do kill -0 "$pid" 2>/dev/null || break; sleep 0.5; done
    kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null || true
  fi
  rm -f "$PIDFILE"
  echo "demo: down"
}

status() {
  if running; then
    echo "demo: running (pid $(cat "$PIDFILE")) on $ADDR"
    curl -fsS "$API/host/status" | head -c 400; echo
  else
    echo "demo: not running"
  fi
  echo "--- host resources ---"
  df -m / | tail -1
  echo "firecracker processes: $(pgrep -c firecracker 2>/dev/null || echo 0)"
}

case "${1:-}" in
  start) start ;;
  stop) stop ;;
  status) status ;;
  *) die "usage: $0 start|stop|status" ;;
esac
