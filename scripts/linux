#!/bin/sh
# ABOUTME: Runs a command on the Linux KVM host named by VMOBS_LINUX_HOST,
# ABOUTME: against a rsynced copy of this tree. Usage: scripts/linux 'go test ./...'
# VMOBS_LINUX_DIR must not contain quotes or shell metacharacters (interpolated into the remote command).
set -eu
HOST="${VMOBS_LINUX_HOST:-}"
[ -n "$HOST" ] || {
  echo "scripts/linux: set VMOBS_LINUX_HOST to your Linux KVM host, e.g." >&2
  echo "  VMOBS_LINUX_HOST=user@host scripts/linux 'go test ./...'" >&2
  echo "  fish: set -gx VMOBS_LINUX_HOST user@host" >&2
  exit 3
}
DEST="${VMOBS_LINUX_DIR:-vmobs-build}"
[ $# -ge 1 ] || { echo "usage: scripts/linux '<command>'" >&2; exit 3; }
cd "$(dirname "$0")/.."
# P-rule: macOS openrsync does not honor ':- .gitignore' for --delete protection; protect remote build artifacts explicitly.
rsync -az --delete --exclude .git --exclude .superpowers \
  --filter=':- .gitignore' --filter='P images/dist/' ./ "$HOST:$DEST/"
# The remote copy arrives without .git, so a gate running there cannot ask git
# which revision it is testing. Carry the answer across; the gate refuses to
# record real-host evidence it cannot bind to a revision
# (tests/integration/evidence_record_test.go).
revision=$(git rev-parse HEAD)
dirty=0
if [ -n "$(git status --porcelain)" ]; then dirty=1; fi
exec ssh "$HOST" "cd '$DEST' && env VMOBS_SOURCE_REVISION='$revision' VMOBS_SOURCE_DIRTY='$dirty' $*"
