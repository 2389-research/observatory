#!/bin/sh
# ABOUTME: Real-usage smoke: boots vmobsd on loopback with a temp state dir and a
# ABOUTME: real template manifest, drives the vmobs CLI, verifies typed exit codes.
set -u
cd "$(dirname "$0")/.."

# Heal a stale inherited GOROOT pointing at a removed toolchain.
if [ -n "${GOROOT:-}" ] && [ ! -d "${GOROOT:-}" ]; then
  unset GOROOT
fi

PORT=18787
TMP=$(mktemp -d)
DAEMON_PID=""
fail=0
note() { printf '%s\n' "$*"; }

cleanup() {
  if [ -n "$DAEMON_PID" ] && kill -0 "$DAEMON_PID" 2>/dev/null; then
    kill "$DAEMON_PID" 2>/dev/null
    wait "$DAEMON_PID" 2>/dev/null
  fi
  rm -rf "$TMP"
}
trap cleanup EXIT INT TERM

# run_expect WANT_EXIT cmd...: run cmd, capture output, assert the exit code.
run_expect() {
  want=$1; shift
  "$@" >"$TMP/out" 2>"$TMP/err"
  got=$?
  if [ "$got" -ne "$want" ]; then
    note "FAIL exit $got (want $want): $*"
    sed 's/^/  stderr: /' "$TMP/err"
    fail=1
    return 1
  fi
  note "PASS exit $want: $*"
}

# out_check description jq_filter: assert jq filter over the last stdout.
out_check() {
  desc=$1; filter=$2
  if jq -e "$filter" <"$TMP/out" >/dev/null 2>&1; then
    note "PASS $desc"
  else
    note "FAIL $desc — output was:"
    sed 's/^/  /' "$TMP/out"
    fail=1
  fi
}

# --- environment: config, template manifest, binaries ---

mkdir -p "$TMP/state/templates" "$TMP/run" "$TMP/etc" "$TMP/bin"

# The smoke runs with require_authentication: true and a temp credential store
# (at $TMP/state/auth, matching the substituted credential_store path).
# The example config's loopback_only mode + loopback bind is preserved.
sed -e "s|127.0.0.1:8787|127.0.0.1:$PORT|g" \
    -e "s|/var/lib/vmobs|$TMP/state|g" \
    -e "s|/run/vmobs|$TMP/run|g" \
    -e "s|/etc/vmobs|$TMP/etc|g" \
    -e "s|require_authentication: false|require_authentication: true|g" \
    docs/examples/host-config.yaml >"$TMP/config.yaml"

cat >"$TMP/state/templates/smoke-tpl.json" <<'EOF'
{
  "template_id": "smoke-tpl-v1",
  "description": "smoke-test template; image paths are not resolvable on a dev host",
  "kernel_image": "/nonexistent/vmlinuz",
  "root_image": "/nonexistent/rootfs.ext4",
  "guest_privilege_profiles": ["unprivileged"],
  "sensors": [],
  "protocol_versions": {"guest": "1"}
}
EOF

if ! go build -o "$TMP/bin" ./cmd/vmobsd ./cmd/vmobs; then
  note "FAIL build"
  exit 1
fi
note "PASS build"

VMOBS="$TMP/bin/vmobs"
API="http://127.0.0.1:$PORT"

# --- bootstrap auth: init credential store, capture the operator token ---

SMOKE_PASS="smokepass123"
INIT_OUT="$TMP/init-auth.out"
if ! printf '%s\n' "$SMOKE_PASS" | "$TMP/bin/vmobsd" init-auth \
    -config "$TMP/config.yaml" -password-stdin >"$INIT_OUT" 2>"$TMP/init-auth.err"; then
  note "FAIL vmobsd init-auth failed:"
  sed 's/^/  /' "$TMP/init-auth.err"
  exit 1
fi
note "PASS vmobsd init-auth"

# Extract the token secret from the "token: vmobs_..." line.
# The secret is captured into a shell variable; it does not appear in notes.
SMOKE_TOKEN=$(grep '^token: ' "$INIT_OUT" | sed 's/^token: //')
if [ -z "$SMOKE_TOKEN" ]; then
  note "FAIL could not extract token from init-auth output"
  exit 1
fi
note "PASS operator token captured (id: $(grep '^token: ' "$INIT_OUT" | cut -c1-12)...)"

# --- start daemon (with auth on) ---

"$TMP/bin/vmobsd" -config "$TMP/config.yaml" >"$TMP/daemon.log" 2>&1 &
DAEMON_PID=$!

i=0
while ! curl -sf "$API/api/v1/meta" >/dev/null 2>&1; do
  i=$((i + 1))
  if [ "$i" -gt 50 ] || ! kill -0 "$DAEMON_PID" 2>/dev/null; then
    note "FAIL daemon did not come up; log:"
    sed 's/^/  /' "$TMP/daemon.log"
    exit 1
  fi
  sleep 0.1
done
note "PASS daemon up on $API (auth on)"

# --- auth boundary: unauthenticated CLI is refused ---

# Without --token the CLI sends no credentials; the API rejects with 401
# (unauthenticated), which the CLI surfaces as exit 1.
run_expect 1 "$VMOBS" --api "$API" vm list
if grep -q "unauthenticated" "$TMP/err" "$TMP/out"; then
  note "PASS proved: unauthenticated vm list exits 1 and names unauthenticated"
else
  note "FAIL unauthenticated vm list did not mention unauthenticated:"
  sed 's/^/  /' "$TMP/err"
  fail=1
fi

# --- auth whoami with a valid token ---

run_expect 0 "$VMOBS" --api "$API" --token "$SMOKE_TOKEN" --json auth whoami &&
  out_check "whoami: authenticated as local_operator via token" \
    '.owner == "local_operator" and .method == "token"'

# --- existing VM/run flow WITH the bearer token ---

run_expect 0 "$VMOBS" --api "$API" --token "$SMOKE_TOKEN" --json meta &&
  out_check "meta reports vms built" '.features.vms == true'

run_expect 0 "$VMOBS" --api "$API" --token "$SMOKE_TOKEN" --json template list &&
  out_check "template served with computed digest" \
    '.templates[0].template_id == "smoke-tpl-v1" and (.templates[0].digest | startswith("sha256:"))'

run_expect 0 "$VMOBS" --api "$API" --token "$SMOKE_TOKEN" --json host status &&
  out_check "host status: runtime honestly unavailable on this host" \
    '.runtime.available == false and (.runtime.reason | length > 0)'

run_expect 0 "$VMOBS" --api "$API" --token "$SMOKE_TOKEN" --json vm list &&
  out_check "vm list empty before create" '.vms | length == 0'

# AT-001: with no runtime, create refuses with a typed error (exit 1)...
run_expect 1 "$VMOBS" --api "$API" --token "$SMOKE_TOKEN" vm create --template smoke-tpl-v1 smokey

# ...and persists nothing.
run_expect 0 "$VMOBS" --api "$API" --token "$SMOKE_TOKEN" --json vm list &&
  out_check "nothing persisted by the refused create (AT-001)" '.vms | length == 0'

run_expect 0 "$VMOBS" --api "$API" --token "$SMOKE_TOKEN" situation
run_expect 1 "$VMOBS" --api "$API" --token "$SMOKE_TOKEN" operation get op-000999
run_expect 3 "$VMOBS" --api "$API" bogus-command

# --- run routes (P4) ---

run_expect 0 "$VMOBS" --api "$API" --token "$SMOKE_TOKEN" --json meta &&
  out_check "meta reports runs built" '.features.runs == true'

run_expect 1 "$VMOBS" --api "$API" --token "$SMOKE_TOKEN" run submit \
  --vm nonexistent-vm --goal "smoke test" \
  --criteria operator_verdict --on-completion keep_running

run_expect 0 "$VMOBS" --api "$API" --token "$SMOKE_TOKEN" --json run list &&
  out_check "run list empty" '.runs | length == 0'

run_expect 1 "$VMOBS" --api "$API" --token "$SMOKE_TOKEN" run get run-000999

# Five run routes reachable — none return 501 on normal-path requests.
check_not_501() {
  desc=$1; shift
  "$@" >"$TMP/out" 2>"$TMP/err"
  got=$?
  status_code=$(jq -r '.code // empty' <"$TMP/out" 2>/dev/null)
  if [ "$status_code" = "missing_capability" ]; then
    note "FAIL $desc — got missing_capability (501); route is not built"
    sed 's/^/  /' "$TMP/out"
    fail=1
  else
    note "PASS $desc (exit $got, code=${status_code:-ok})"
  fi
}

check_not_501 "POST /vms/{id}/runs reachable" \
  curl -sf -X POST -H "Content-Type: application/json" \
  -H "Authorization: Bearer $SMOKE_TOKEN" \
  -d '{"goal":"smoke","success_criteria":{"type":"operator_verdict"},"on_completion":"keep_running"}' \
  "$API/api/v1/vms/nonexistent-vm/runs"

check_not_501 "GET /runs reachable" \
  curl -sf -H "Authorization: Bearer $SMOKE_TOKEN" "$API/api/v1/runs"

check_not_501 "GET /runs/{id} reachable" \
  curl -sf -H "Authorization: Bearer $SMOKE_TOKEN" "$API/api/v1/runs/run-000999"

check_not_501 "GET /runs/{id}/report reachable" \
  curl -sf -H "Authorization: Bearer $SMOKE_TOKEN" "$API/api/v1/runs/run-000999/report"

check_not_501 "POST /runs/{id}/conclude reachable" \
  curl -sf -X POST -H "Content-Type: application/json" \
  -H "Authorization: Bearer $SMOKE_TOKEN" \
  -d '{"verdict":"succeeded"}' \
  "$API/api/v1/runs/run-000999/conclude"

# --- cookie / CSRF flow ---

COOKIEJAR="$TMP/cookies.txt"

# Login with the correct password → get session cookie + csrf_token.
# curl sends no Origin header here: the origin check is browser-only and
# only fires when Origin is present and mismatches; absent Origin passes.
curl -sf -X POST \
  -H "Content-Type: application/json" \
  -d "{\"username\":\"local_operator\",\"password\":\"$SMOKE_PASS\"}" \
  -c "$COOKIEJAR" \
  "$API/api/v1/auth/login" >"$TMP/out" 2>"$TMP/err"
if [ $? -ne 0 ]; then
  note "FAIL login request failed:"
  sed 's/^/  /' "$TMP/err"
  fail=1
else
  note "PASS login: POST /auth/login → 200"
fi
out_check "login: received csrf_token" '(.csrf_token | type) == "string" and (.csrf_token | length > 0)'

# Mutation without CSRF → 403 csrf_rejected.
# Using -s (not -f) so curl exits 0 even on HTTP 4xx; we check the status code.
CSRF_HTTP=$(curl -s -o "$TMP/out" -w '%{http_code}' \
  -X POST -H "Content-Type: application/json" \
  -b "$COOKIEJAR" \
  -d '{"name":"bad-token"}' \
  "$API/api/v1/auth/tokens" 2>"$TMP/err")
if [ "$CSRF_HTTP" = "403" ]; then
  note "PASS proved: mutation without CSRF header → 403 (csrf_rejected)"
else
  note "FAIL mutation without CSRF should return 403, got $CSRF_HTTP"
  sed 's/^/  /' "$TMP/out"
  fail=1
fi

# GET /auth/session with the cookie → returns csrf_token for use in mutations.
curl -sf \
  -b "$COOKIEJAR" \
  "$API/api/v1/auth/session" >"$TMP/out" 2>"$TMP/err"
if [ $? -ne 0 ]; then
  note "FAIL GET /auth/session failed:"
  sed 's/^/  /' "$TMP/err"
  fail=1
else
  note "PASS GET /auth/session → 200"
fi
out_check "GET /auth/session: returns csrf_token and session method" \
  '(.csrf_token | type) == "string" and .method == "session"'
CSRF_TOKEN=$(jq -r '.csrf_token' <"$TMP/out")
if [ -n "$CSRF_TOKEN" ] && [ "$CSRF_TOKEN" != "null" ]; then
  note "PASS csrf_token captured from /auth/session"
else
  note "FAIL csrf_token missing or null from /auth/session"
  fail=1
fi

# Mutation with cookie + correct CSRF → success (create a token via session).
curl -sf -X POST \
  -H "Content-Type: application/json" \
  -H "X-CSRF-Token: $CSRF_TOKEN" \
  -b "$COOKIEJAR" \
  -d '{"name":"smoke-session-token"}' \
  "$API/api/v1/auth/tokens" >"$TMP/out" 2>"$TMP/err"
if [ $? -ne 0 ]; then
  note "FAIL cookie+CSRF mutation failed:"
  sed 's/^/  /' "$TMP/err"
  fail=1
else
  note "PASS cookie+CSRF mutation: POST /auth/tokens → 201"
fi
out_check "cookie+CSRF mutation: token created" \
  '(.token.id | type) == "string" and (.secret | startswith("vmobs_"))'
note "PASS proved: cookie+CSRF mutation succeeds"

# --- CLI token revoke: revoked token is rejected ---

# Capture the ID of the initial token (the one we've been using).
# vmobs auth tokens lists all tokens; we find the one named "initial".
run_expect 0 "$VMOBS" --api "$API" --token "$SMOKE_TOKEN" --json auth tokens
INITIAL_TOKEN_ID=$(jq -r '.tokens[] | select(.name == "initial") | .id' <"$TMP/out")
if [ -z "$INITIAL_TOKEN_ID" ]; then
  note "FAIL could not find 'initial' token in token list"
  fail=1
else
  note "PASS found initial token id: $INITIAL_TOKEN_ID"

  # Revoke it via CLI (using the token itself to authenticate the revoke).
  run_expect 0 "$VMOBS" --api "$API" --token "$SMOKE_TOKEN" auth token revoke "$INITIAL_TOKEN_ID" &&
    note "PASS proved: token revoke succeeds"

  # Now the same token is rejected → exit 1.
  run_expect 1 "$VMOBS" --api "$API" --token "$SMOKE_TOKEN" auth whoami &&
    note "PASS proved: revoked token exits 1 (bearer token rejected after revoke)"
fi

# --- shutdown: clean exit, then transport failure is exit 2 ---

kill "$DAEMON_PID"
if wait "$DAEMON_PID"; then
  note "PASS daemon shut down cleanly"
else
  note "FAIL daemon exited nonzero on SIGTERM"
  fail=1
fi
DAEMON_PID=""

run_expect 2 "$VMOBS" --api "$API" meta

if [ "$fail" -ne 0 ]; then
  note "smoke: FAILED"
  exit 1
fi
note "smoke: all checks passed"
