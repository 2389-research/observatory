# ABOUTME: AppArmor profile for the vmobs runtime container: Docker's default plus
# ABOUTME: the four mount-family operations the Firecracker jailer measurably makes.
#
# Derived from moby v27.2.1 profiles/apparmor/template.go
# (sha256 42130ca5908f45263facef820961d9e1a988e82f8a2937f4658e7bcccc96cc07),
# rendered with Name=vmobs-jailer and DaemonProfile=unconfined.
#
# The only change from that template is the `deny mount,` line, which is replaced
# by rules permitting exactly what the two confined programs were traced doing and
# nothing else.
#
# `jailer`, per launch:
#
#   setns(3, CLONE_NEWNET)                              -- no mount rule needed
#   unshare(CLONE_NEWNS)                                -- no mount rule needed
#   mount(NULL, "/", NULL, MS_REC|MS_SLAVE, NULL)
#   mount(<jail>/root, <jail>/root, NULL, MS_BIND|MS_REC, NULL)
#   pivot_root(".", "old_root")
#   umount2("old_root", MNT_DETACH)
#
# `vmobs-privd`, once at startup, running its jail probe child:
#
#   mount(NULL, "/", NULL, MS_REC|MS_PRIVATE, NULL)     -- made by Go, not by us
#
# The rest of that probe is the jailer's own sequence run against a scratch
# chroot under /srv/vmobs/jail/firecracker/, plus a real `ip netns add`, so it
# needs no rules of its own -- it exercises the ones below.
#
# `vmobs-privd`, per launch, in `ip netns add`:
#
#   mount("/proc/self/ns/net", /run/netns/<vm>, NULL, MS_BIND, NULL)
#
# Everything else the jailer does -- mknod of /dev/{kvm,net/tun,urandom,userfaultfd}
# and chown of the jail tree -- is covered by the template's blanket `capability,`
# and `file,` rules, which are unchanged.
#
# Load once, as root:  apparmor_parser -r -W deploy/apparmor/vmobs-jailer
# Then:                docker run --security-opt apparmor=vmobs-jailer ...

#include <tunables/global>

profile vmobs-jailer flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  capability,
  file,
  umount,
  # Host (privileged) processes may send signals to container processes.
  signal (receive) peer=unconfined,
  # runc may send signals to container processes (for "docker stop").
  signal (receive) peer=runc,
  # crun may send signals to container processes (for "docker stop" when used with crun OCI runtime).
  signal (receive) peer=crun,
  # dockerd may send signals to container processes (for "docker kill").
  signal (receive) peer=unconfined,
  # Container processes may send signals amongst themselves.
  signal (send,receive) peer=vmobs-jailer,

  deny @{PROC}/* w,   # deny write for all files directly in /proc (not in a subdir)
  # deny write to files not in /proc/<number>/** or /proc/sys/**
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,  # deny /proc/sys except /proc/sys/k* (effectively /proc/sys/kernel)
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,  # deny everything except shm* in /proc/sys/kernel/
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  # --- replaces the template's `deny mount,` -------------------------------
  # The jailer makes the container's mount tree private before pivoting, so a
  # mount it creates cannot propagate back to the host.
  mount options=(rw, rslave) -> /,
  # privd's jail probe forks a child holding CLONE_NEWNS, and Go's exec marks /
  # private in that child before execve (syscall/exec_linux.go). It is a second,
  # stricter propagation change on the same mount point, made by the runtime
  # rather than by any code here -- which is why tracing the jailer never found
  # it. Denied, the kernel raises EACCES in the forked child and Go reports an
  # exec failure naming no mount at all; privd then refuses to bind its socket.
  mount options=(rw, rprivate) -> /,
  # pivot_root needs its new root to be a mount point; the jailer bind-mounts
  # each jail directory onto itself to make one. Confined to the chroot base.
  mount options=(rw, rbind) /srv/vmobs/jail/** -> /srv/vmobs/jail/**,
  # `ip netns add` names a network namespace by bind-mounting /proc/self/ns/net
  # onto a file under /run/netns, and privd runs that verb for every VM. The
  # jailer never does, which is why tracing the jailer found none of these three
  # rules and privd was denied its own startup.
  #
  # Before that bind, iproute2 marks /run/netns shared so the name is visible in
  # every mount namespace. That was measured:
  #
  #   apparmor="DENIED" operation="mount" info="failed mntpnt match" error=-13
  #   profile="vmobs-jailer" name="/run/netns/" comm="ip" flags="rw, rshared"
  #
  # MS_SHARED needs a mount point and /run/netns is a plain directory inside the
  # /run tmpfs, so that first attempt returns EINVAL and iproute2 binds the
  # directory onto itself to make one. Both bind forms are listed because
  # AppArmor matches the recursion flag exactly and which one iproute2 passes is
  # not something to guess at; they name the same single path either way.
  #
  # The per-namespace bind's source is unconstrained because /proc/self/ns/net is
  # a magic link the kernel reports to AppArmor as "/". Every mount point here is
  # exact.
  mount options=(rw, rshared) -> /run/netns/,
  mount options=(rw, bind) /run/netns/ -> /run/netns/,
  mount options=(rw, rbind) /run/netns/ -> /run/netns/,
  mount options=(rw, bind) -> /run/netns/*,
  # `ip netns exec` enters a namespace and then replaces /sys with a sysfs
  # instance describing it, so that /sys/class/net shows that namespace's
  # interfaces. privd runs every network setup command that way. Measured:
  #
  #   apparmor="DENIED" operation="mount" info="failed mntpnt match" error=-13
  #   profile="vmobs-jailer" name="/sys/" comm="ip" fstype="sysfs"
  #   srcname="vmobs-<vm id>"
  #
  # The source is the namespace's name rather than a path, so only the
  # filesystem type and the mount point are constrained. The MNT_DETACH of the
  # old /sys that precedes it is covered by `umount,` above.
  mount fstype=sysfs -> /sys/,
  pivot_root /srv/vmobs/jail/firecracker/*/root/,
  # `umount,` above covers the MNT_DETACH of the old root.
  # No blanket `mount,` rule follows: anything not listed above stays denied.
  # A `deny mount` rule is deliberately absent -- AppArmor deny is absolute and
  # would override the three allows regardless of order.
  # -------------------------------------------------------------------------

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  # suppress ptrace denials when using 'docker ps' or using 'ps' inside a container
  ptrace (trace,read,tracedby,readby) peer=vmobs-jailer,
}
