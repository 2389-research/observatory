{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vmobs:schema:launch-request:1",
  "title": "Firecracker Observatory VM launch request v1",
  "description": "Proposed request contract. Numeric ranges are project input bounds, not available host capacity or benchmark results. Server-side authorization, capacity, template, policy and compatibility validation are mandatory.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "template_digest",
    "resources",
    "guest_privilege",
    "network",
    "observation",
    "capture",
    "idempotency_key"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
    },
    "template_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vcpu_count",
        "memory_mib",
        "root_disk_mib",
        "workspace_disk_mib"
      ],
      "properties": {
        "vcpu_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "memory_mib": {
          "type": "integer",
          "minimum": 512,
          "maximum": 32768
        },
        "root_disk_mib": {
          "type": "integer",
          "minimum": 2048,
          "maximum": 131072
        },
        "workspace_disk_mib": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 131072
        }
      }
    },
    "guest_privilege": {
      "enum": [
        "unprivileged",
        "developer_root"
      ]
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "policy_id"
      ],
      "properties": {
        "profile": {
          "enum": [
            "offline",
            "transport",
            "http_inspect"
          ]
        },
        "policy_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filesystem_reads",
        "require_telemetry",
        "on_failure",
        "heartbeat_timeout_seconds"
      ],
      "properties": {
        "filesystem_reads": {
          "type": "boolean"
        },
        "require_telemetry": {
          "type": "boolean"
        },
        "on_failure": {
          "enum": [
            "degrade",
            "pause",
            "stop"
          ]
        },
        "heartbeat_timeout_seconds": {
          "type": "integer",
          "minimum": 2,
          "maximum": 60
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "require_telemetry": {
                "const": true
              }
            },
            "required": [
              "require_telemetry"
            ]
          },
          "then": {
            "properties": {
              "on_failure": {
                "enum": [
                  "pause",
                  "stop"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "on_failure": {
                "const": "degrade"
              }
            }
          }
        }
      ]
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "http_headers",
        "http_body_mode",
        "terminal_recording",
        "pcap"
      ],
      "properties": {
        "http_headers": {
          "enum": [
            "none",
            "redacted"
          ]
        },
        "http_body_mode": {
          "enum": [
            "off",
            "bounded_text"
          ]
        },
        "terminal_recording": {
          "type": "boolean"
        },
        "pcap": {
          "type": "boolean"
        }
      }
    },
    "workspace_seed_artifact_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "initial_exec": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "argv",
            "cwd",
            "timeout_seconds"
          ],
          "properties": {
            "argv": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "items": {
                "type": "string",
                "maxLength": 4096
              },
              "prefixItems": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              ]
            },
            "cwd": {
              "type": "string",
              "pattern": "^/",
              "maxLength": 4096
            },
            "timeout_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            },
            "stdout_limit_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 104857600
            },
            "stderr_limit_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 104857600
            },
            "secret_refs": {
              "type": "object",
              "maxProperties": 32,
              "propertyNames": {
                "pattern": "^[A-Z_][A-Z0-9_]{0,63}$"
              },
              "additionalProperties": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "queue_if_capacity_unavailable": {
      "type": "boolean"
    },
    "labels": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,63}$"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 256
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        },
        "artifact_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "network": {
            "properties": {
              "profile": {
                "enum": [
                  "offline",
                  "transport"
                ]
              }
            },
            "required": [
              "profile"
            ]
          }
        },
        "required": [
          "network"
        ]
      },
      "then": {
        "properties": {
          "capture": {
            "properties": {
              "http_headers": {
                "const": "none"
              },
              "http_body_mode": {
                "const": "off"
              }
            }
          }
        }
      }
    }
  ]
}
