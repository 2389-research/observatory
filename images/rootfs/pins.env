# ABOUTME: Pinned image references and snapshot timestamps for reproducible builds.
# ABOUTME: Source these before any build script that uses docker or apt snapshots.
#
# ubuntu:24.04 digest resolved on aibox03 (2026-09-01):
#   docker pull ubuntu:24.04
#   docker inspect --format '{{index .RepoDigests 0}}' ubuntu:24.04
#
BASE_IMAGE_REF="ubuntu@sha256:33ceb71981b602c1a7443a53469e4dba065f7503eab3078a2d7a57a2ab987517"

# Ubuntu snapshot timestamp for apt installs inside the rootfs container.
# Format: YYYYMMDDTHHMMSSZ (snapshot.ubuntu.com namespace).
# Verified working on aibox03 using Ubuntu 24.04's apt -S flag.
# apt invocation: apt-get -S "$APT_SNAPSHOT" install ...
# NOTE: must install ca-certificates first (via live apt) to reach snapshot.ubuntu.com over TLS.
# Reproducibility caveat: snapshot.ubuntu.com content at this timestamp is frozen;
#   future runs get the same package versions.
#
APT_SNAPSHOT="20260820T000000Z"
