# Build context for deploy/Dockerfile.
#
# images/ is excluded and then two files are put back: the pinned guest kernel
# and root image, which the appliance stage bakes in. Everything else under
# images/ is build scratch -- an unpacked rootfs tree and its logs -- and
# shipping it to the daemon costs a gigabyte per build for nothing.

.git
.github
.private-journal
.superpowers
.roborev
.kata.toml
.kata.local.toml

bin/
docs/
web/node_modules/
web/tsconfig.tsbuildinfo

# tests/ is excluded and one file is put back: the narrow root helper the M0
# network fixture execs through sudo. deploy/Dockerfile.gate installs it into a
# throwaway gate image, which is the only place it ever runs.
tests/
!tests/integration/fixture/vmobs-root-helper

images
!images/dist/vmlinux
!images/dist/rootfs.ext4

*.sqlite
*.sqlite-wal
*.sqlite-shm
coverage.out
.DS_Store
